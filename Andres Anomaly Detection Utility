# ======================================================================
#                     ANOMALY DETECTION UTILITY 
# ======================================================================

#title: 'Anomaly Detection'
#btn: 'Run Anomaly Detection'

class AnomalyDetectionUtility:

    def __init__(self, db=None):
        """
        db may be None when loaded by the dynamic main script.
        The class MUST handle missing DB without errors.
        """
        self.db = db

    # ------------------------------------------------------------------
    # SAFE SQL EXECUTION
    # ------------------------------------------------------------------
    def safe_query(self, sql):
        """
        Executes SQL safely and ALWAYS returns rows without raising exceptions.
        This prevents GUI crashes.
        """

        # No DB provided
        if self.db is None or not hasattr(self.db, "query"):
            return [["QUERY ERROR", "No database connection was provided."]]

        try:
            return self.db.query(sql)
        except Exception as e:
            return [["QUERY ERROR", str(e)]]

    # ------------------------------------------------------------------
    # Main SQL logic (robust to missing tables)
    # ------------------------------------------------------------------
    def find_anomalies(self, table, column, z_threshold=3.0):

        # Basic sanitization so SQL Server doesn't reject names
        table = table.strip().strip("[]")
        column = column.strip().strip("[]")

        # Build safe SQL
        sql = f"""
        WITH stats AS (
            SELECT AVG(CAST({column} AS FLOAT)) AS mean_val,
                   STDEV(CAST({column} AS FLOAT)) AS std_val
            FROM [{table}]
        ),
        z AS (
            SELECT *,
                   (CAST({column} AS FLOAT) - stats.mean_val) / NULLIF(stats.std_val, 0) AS zscore
            FROM [{table}], stats
            WHERE {column} IS NOT NULL
        )
        SELECT *
        FROM z
        WHERE ABS(zscore) > {z_threshold}
        ORDER BY zscore DESC;
        """

        return self.safe_query(sql)

    # ------------------------------------------------------------------
    def format_anomalies(self, rows):
        """
        rows might be:
        - valid data
        - [["QUERY ERROR", details]]
        - empty list

        ALWAYS returns a list of lists (GUI safe)
        """
        try:
            return [[str(x) for x in r] for r in rows[:50]]
        except:
            return [["FORMAT ERROR"]]

    # ==================================================================
    #                     BUTTON GETTER (REQUIRED FORMAT)
    # ==================================================================
    def get_run_anomaly_detection(self):
        """
        Getter for the 'Run Anomaly Detection' button.
        Must return (columns, rows), NEVER errors.
        """

        # ---- Check required attributes ----
        missing = []
        for attr in ["table", "column", "z_threshold"]:
            if not hasattr(self, attr):
                missing.append(attr)

        if missing:
            return ("Error",), [(f"Missing inputs: {', '.join(missing)}",)]

        table = str(self.table).strip()
        column = str(self.column).strip()

        # ---- Validate Z-threshold ----
        try:
            z = float(self.z_threshold)
        except:
            return ("Error",), [("Z-threshold must be numeric.",)]

        # ---- Run anomaly detection ----
        rows = self.find_anomalies(table, column, z)

        # ERROR ROW: [["QUERY ERROR", detail]]
        if isinstance(rows, list) and rows and "QUERY ERROR" in rows[0][0]:
            return ("Error", "Detail"), rows

        # NO DATA
        if not rows:
            return ("Message",), [("No anomalies found.",)]

        formatted = self.format_anomalies(rows)

        # Dynamic column headers (Col 1, Col 2, ...)
        col_count = len(formatted[0])
        columns = tuple(f"Col {i+1}" for i in range(col_count))

        return columns, formatted
